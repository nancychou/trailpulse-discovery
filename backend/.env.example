# Supabase PostgreSQL direct connection (change scheme to postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Supabase project config (for auth + storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS
FRONTEND_URL=http://localhost:3000
